# ============================================================
# tg-media-hub 环境变量配置模板
# 使用方法: 复制本文件为 .env 并填写真实值 (cp .env.example .env)
# 加载机制: app/config.py 启动时读取项目根目录 .env; 已存在的系统环境变量优先
# 完整字段说明与代码出处见 README.md「环境变量配置说明」章节
# ============================================================

# ==== Telegram API 凭证 (必填, https://my.telegram.org 申请) ====
TG_API_ID=12345678
TG_API_HASH=your_api_hash_here

# 默认 Userbot 登录手机号 (可选；配置后将在首次绑定时锁定该国际格式号码，留空则由已认证部署者指定)
TG_DEFAULT_PHONE=

# ==== Bot 令牌池 (必填) ====
# 逗号分隔多个 Bot Token (推荐 4 个, 用于发布分流与多客户端联合下载); 首次启动自动批量注册入库
TG_BOT_TOKENS=bot_token_1,bot_token_2,bot_token_3,bot_token_4

# ==== Web 控制台服务 ====
# HOST: 本机直跑默认回环。官方 Compose 在容器内显式绑定 0.0.0.0。
# 绑定 0.0.0.0/:: 或其他非回环地址时，API_KEY 留空会锁定业务，本机回环请求也一样。
HOST=127.0.0.1
# PORT: Web 端口 (本地启动被占用时自动顺延, 最多 +20)。
# 注意: Docker 场景请保持 8500 —— 容器内 EXPOSE 与健康检查均固定 8500, 更换对外端口只改 docker-compose.yml ports 左侧
PORT=8500
# TG_PORT=8500  # 向后兼容别名
# DEBUG: 调试模式开关 (默认 false)
DEBUG=false

# Userbot 会话名称 (Session 文件名前缀, 生成 <name>.session)
USERBOT_SESSION_NAME=userbot_session

# 默认转存目标频道 ID (占位值, 请替换为真实频道 ID, 格式 -100XXXXXXXXXX)
DEFAULT_TARGET_CHANNEL=-1009000000010

# ==== Web 安全与鉴权 ====
# TG_BOOTSTRAP_TOKEN: 部署者首次绑定 / 受限引导认证高熵值密钥 (至少 16 位随机字符)。
# 仅在默认 Userbot 未绑定或未验证的受限引导态生效，用于 X-Bootstrap-Token 认证，正常绑定后自动失效
TG_BOOTSTRAP_TOKEN=

# API_KEY: 控制台访问口令。仅「绑定 127.0.0.1/::1 的本机直跑」且留空时免认证 (跳过 API Key
# 与 Web 2FA 校验); 容器部署/公网部署/反向代理转发入口必须配置强随机值, 否则业务 API、媒体
# 票据、预览、下载与 WebSocket 全部锁定, 控制台将提示部署者完成配置。设置后所有业务 API 需
# 携带 X-API-Key 请求头, 且另需 Web 2FA 会话令牌 X-2FA-Token (/metrics 与 /openapi.json 仅需 X-API-Key)
API_KEY=
# TG_API_KEY=  # 已移除的历史别名: 残留该变量且未设置 API_KEY 时启动将直接报错要求改名

# 公网反代部署必须改为 true，即使 HOST 绑定回环。这样转发头缺失时仍执行公网认证策略。
# 官方 Compose 已开启。仅本机直连并且需要免认证时保持 false。
CONSOLE_REQUIRE_API_KEY=false

# SECRET_KEY: Web 2FA 会话 JWT (HS256) 签名密钥。留空时自动生成并持久化到 DATA_DIR/.web_2fa_secret
# (服务器端密钥, 绝不从 API_KEY 派生); 显式设置后与持久密钥解耦, 轮换会使已签发会话立即失效
SECRET_KEY=

# TRUSTED_PROXIES: 可信反向代理网段白名单 (CIDR, 逗号分隔), 用于解析 X-Forwarded-For 还原真实客户端 IP;
# 禁止设为 "*" (启动时直接拒绝)。默认覆盖 Docker 网桥与本机回环; 反代 (如 Caddy/Nginx) 必须在名单内
TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1

# CORS_ORIGINS: 允许的跨域来源, 逗号分隔 (默认本机 8500 端口的两种写法)
CORS_ORIGINS=http://localhost:8500,http://127.0.0.1:8500

# RATE_LIMIT_PER_MINUTE: 单 IP 滑动窗口限流阈值 (次/分钟); 设为 0 或负数关闭限流
RATE_LIMIT_PER_MINUTE=120

# ==== 下载 / 发布引擎 ====
# 非 Premium 账号单文件上传上限 (MB); Telegram 协议绝对硬顶 4096 MiB (4.00 GiB)
MAX_FILE_SIZE_MB=2000
# Premium 账号单文件上传上限 (MB); 设为 2000 可运行时收回 4000 MiB (3.91 GiB) 能力
PREMIUM_MAX_FILE_SIZE_MB=4000

# DOWNLOAD_PARALLEL_CONNECTIONS: 下载 MTProto 并发通道数 (默认 8)
DOWNLOAD_PARALLEL_CONNECTIONS=8
# UPLOAD_PARALLEL_CONNECTIONS: 本地上传 MTProto 并发通道数 (默认 2)
UPLOAD_PARALLEL_CONNECTIONS=2
# UPLOAD_IN_FLIGHT_PER_CONNECTION: 单上传连接在途请求数 (Pipelining 深度，默认 2，范围 1-4)
UPLOAD_IN_FLIGHT_PER_CONNECTION=2
# GRACEFUL_STOP_TIMEOUT: 任务与传输连接优雅停止超时时间 (秒，默认 10.0)
GRACEFUL_STOP_TIMEOUT=10.0
# PLACEHOLDER_ASSET_PATH: 任务失败占位卡静态海报路径 (16:9 JPEG，留空使用内置默认资产)
PLACEHOLDER_ASSET_PATH=

# USERBOT_UPLOAD_THRESHOLD: 发布时小文件走 Bot 轮询、超过阈值自动切 Userbot 上传 (单位 MB, 默认 30)。
# 设置中心动态项 userbot_upload_threshold_mb 优先, 仅当该动态项缺失时此环境变量兜底;
# 首次建库时该变量的当前值会作为设置中心该动态项的初始种子值 (app/db/database.py _bootstrap_from_env)
# (正常部署中种子行已存在, 修改请走设置中心; 历史版本曾按字节解析, 存量 .env 若按字节设值请改为 MB 值)
USERBOT_UPLOAD_THRESHOLD=30

# 服务启动时是否自动恢复遗留未完成任务为 queued (默认 false = 安全暂停保护, 断点保留);
# 设置中心的同名动态项可覆盖此环境变量
AUTO_RESUME_TASKS_ON_STARTUP=false

# ==== 多 Userbot 联合下载与中转加速 ====
# 下载时是否组装多客户端 (主 Userbot + 就绪 Bot 池) 联合并发通道
ENABLE_MULTI_USERBOT_DOWNLOAD=true

# 私有频道账号可达性探针结果缓存 TTL (秒), 防止重复探测引发 API 压力
USERBOT_ACCESS_CACHE_TTL=60.0

# 静默中转群借壳加速总开关 (设置中心动态项 enable_transit_acceleration 可覆盖)
ENABLE_TRANSIT_ACCELERATION=true
# 中转群组/频道 ID (如 -100XXXXXXXXXX); 留空则中转加速不生效。
# 使用前提: 主 Userbot 已入群且有发信/删信权限, 全部辅助 Bot 已入群 (可用设置中心「验证中转配置」探针体检)
TRANSIT_CHAT_ID=
# 触发中转加速的最小文件体积 (MB)
TRANSIT_MIN_FILE_SIZE_MB=20

# ==== PikPak 流式发布 ====
# PIKPAK_TOKEN: PikPak API Token (环境变量凭据, 优先级高于 CLI 已存凭据);
# 红线: 只从环境变量读取, 永不写入日志/数据库/API 响应
PIKPAK_TOKEN=
# PIKPAK_DIR: pikpak CLI 凭据与状态目录 (容器内必须落在 /app/data 挂载卷, 防容器重建丢失)
PIKPAK_DIR=/app/data/.pikpak
# PIKPAK_META_DIR: Provider 断点元数据沙箱根 (零媒体落盘; 命名助手与 GC 共用唯一常量源)
PIKPAK_META_DIR=/app/data/upload_meta
PIKPAK_NO_UPDATE_NOTIFIER=1
PIKPAK_NO_LOG=1
# 流式预读窗口提示 (MB) 与 L1 环形容灾缓存开关 (1C1G 降级档置 false)
PIKPAK_STREAM_PREFETCH_MB=32
PIKPAK_ENABLE_RING_BUFFER=true
# L1 环形容灾缓存字节预算 (MB)
PIKPAK_RING_BUFFER_MB=50
# PikPak 发布默认并发档 (稳健档: 2 通道 x 单连接 1 在途; 极速档依赖 Premium 账号, 属后续可选)
PIKPAK_UPLOAD_CONCURRENCY=2
PIKPAK_UPLOAD_IN_FLIGHT=1
# PIKPAK_PREFETCH_CONCURRENCY: 预取并发连接数 (默认 3)
PIKPAK_PREFETCH_CONCURRENCY=3
# PIKPAK_PROXY_URL: PikPak API 与流式拉取代理 URL (如 http://127.0.0.1:7890，留空直连)
PIKPAK_PROXY_URL=
# pikpak CLI 可执行文件路径 (单测指向 fake CLI)
PIKPAK_CLI_BIN=pikpak
# 超限大文件流式切片发布策略 (缺省与运行时设置键 pikpak_default_split_strategy 一致):
#   vsse_with_fallback: (缺省极速主通道) 纯 Python 虚拟 MP4 外包络秒级切片，非标布局自动降级至 fMP4
#   fmp4_universal: 基于 FFmpeg 管道的零落盘 fMP4 可播分卷，全能适配任意视频与容器格式
#   raw: (存量兼容) 裸二进制硬切，无播放能力
# 应急回滚: 若 VSSE 通道发生任何未预期异常，将此项设为 fmp4_universal 即可恢复阶段一全能保底通道
SPLIT_STRATEGY=vsse_with_fallback

# SQLite WAL 自保参数: 定期 PASSIVE 检查点周期 (秒) 与 WAL 体积告警阈值 (字节, 默认 50MB)
WAL_CHECKPOINT_INTERVAL_SECONDS=300.0
WAL_SIZE_WARNING_THRESHOLD_BYTES=52428800
# 任务日志保留策略: 启动期按任务修剪, 每任务保留最新 N 条 (防长任务日志无界增长)
TASK_LOGS_RETENTION_PER_TASK=5000

# E2E_CAPTURE_MODE: E2E 捕获/取证模式 (默认 false)。开启后超限流式切片发布为每条目留存
# 三份证据 (源快照/切分产物/TG 镜像), 用于离线对比分析; 磁盘成本 ~3x 源体积/条目, 手动清理。
# 生产模式语义与零盘承诺完全不变; 改开关需重启服务。离线工具: scripts/e2e_tg_mirror.py + scripts/e2e_compare.py
E2E_CAPTURE_MODE=false
# E2E_CAPTURE_DIR: 捕获证据根目录 (本地默认 data/e2e_capture; 布局 <task_id>/<item_id>/)
E2E_CAPTURE_DIR=data/e2e_capture
# E2E_FORCE_PAGED_PROXY: E2E 强制分页代理 (默认 false)。开启后 fmp4_universal 直连切片
# 通道改由 LocalPagedRangeProxy 供流 (生产下代理仅由 VSSE 熔断降级触发), 用于 E2E 真链路
# 验证代理路径; 生产语义不变, 改开关需重启服务。
E2E_FORCE_PAGED_PROXY=false

# AUTO_REMUX_MPEGTS_TO_MP4: 发布 .ts/.m2ts/.mts 视频前自动零落盘重封装为 MP4 (默认 true)。
# Telegram 服务端入库时会剥离 mpegts 视频属性导致无法在线流播; 设置中心同名动态项可覆盖
AUTO_REMUX_MPEGTS_TO_MP4=true


# ==== 测试专用 (仅 pytest 使用, 运行时不参与业务) ====
TEST_CHANNEL_LINK=https://t.me/telegram/1
TEST_SAMPLE_FOLDER=C:\Downloads\SampleFolder\@SampleTag #Tag1 #Tag2
